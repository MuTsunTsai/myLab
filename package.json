{
	"name": "mylab",
	"version": "1.0.0",
	"private": true,
	"description": "星君研究室的 WordPress 佈景主題",
	"type": "module",
	"scripts": {
		"build": "rsbuild build",
		"watch": "rsbuild build --watch",
		"preview": "wp-playground-cli server --port=9400 --mount-dir ./theme /wordpress/wp-content/themes/mylab --mount-dir ./preview /wordpress/preview --blueprint=./preview/blueprint.json --login",
		"typecheck": "tsc --noEmit",
		"package": "node scripts/package.mjs",
		"release": "node scripts/release.mjs"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@popperjs/core": "^2.11.8",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.2",
		"katex": "^0.19.0",
		"mermaid": "^12.2.0",
		"shiki": "^4.5.0"
	},
	"devDependencies": {
		"@rsbuild/core": "^2.2.14",
		"@rsbuild/plugin-sass": "^2.0.1",
		"@types/bootstrap": "^5.2.11",
		"@wp-playground/cli": "^3.1.60",
		"fflate": "^0.8.3",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.6.0"
}
